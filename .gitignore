# Keep run plans, reports and collected data out of source history; pure tests are tracked.
/m1-sample/
/projects/code/plans/
/projects/sample/
/projects/prd/*
!/projects/prd/总体任务执行书.md
!/projects/prd/M1-规则说明.md
!/projects/prd/M1-检查清单.md
