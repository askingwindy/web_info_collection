      "single_cjk_token": true,
      "weight": "term-frequency",
      "hash": "SHA256-first-8-bytes-big-endian",
      "tie": 0,
      "maximum_hamming": 3
    }
  },
  "targets": {
    "expected_samples": null,
    "max_category_share": 0.2,
